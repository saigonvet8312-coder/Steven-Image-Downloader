{
  "name": "Steven Image Downloader",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "bash start.sh",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "Steven Image Downloader", "onAutoForward": "openBrowser", "visibility": "private" },
    "8000": { "label": "Backend API (không cần mở)", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
